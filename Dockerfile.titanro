# TitanRO image (upstream's Dockerfile is left untouched for their docker-compose setups).
# doctl registry login --expiry-seconds 3600 && docker build -f Dockerfile.titanro -t registry.digitalocean.com/titanro-nyc/robrowserlegacy . && docker image push registry.digitalocean.com/titanro-nyc/robrowserlegacy
# Normally built by Tekton Pipelines-as-Code (.tekton/push.yaml) on pushes to master; titanro-ci[bot] pins the digest in
# TitanRO/sysops argo/prod-season/robrowser and argo/test-season/robrowser, and Argo CD deploys it.

FROM node:24.22.2 AS node

WORKDIR /usr/app

# Dependencies first, so the npm install layer stays cached until package.json changes
# (package-lock.json is gitignored upstream; the glob picks it up if one is ever committed).
COPY package*.json ./
RUN npm install

COPY ./ ./
RUN npm run build -- -O -T -H


FROM php:8-apache

RUN apt-get update -y && apt-get install -y libpng-dev
RUN docker-php-ext-install pdo pdo_mysql mysqli gd
RUN a2enmod rewrite

# dist/Web: index.html, Config.js (upstream defaults), Online.js, ThreadEventHandler.js, PathFindingWorker.js.
# Plugins in src/Plugins are bundled into Online.js. Config.local.js holds our settings (merged over Config.js).
COPY --from=node /usr/app/dist/Web /var/www/html
COPY ./Config.local.js /var/www/html/

RUN chown -R www-data:www-data /var/www/html
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
